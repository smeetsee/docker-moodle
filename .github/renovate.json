{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^moodle-version\\.env$/"
      ],
      "matchStrings": [
        "^VERSION=(?<currentValue>[^\\r\\n]+)$"
      ],
      "depNameTemplate": "moodle/moodle",
      "datasourceTemplate": "packagist",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ]
}